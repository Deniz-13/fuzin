#!/bin/bash

set -o pipefail

Usage() {
    echo "Usage: fuzin [-i|--install] [-r|--remove] [-y|--yay] [-p|--paru] [-h|--help]"
}

ParseArguments() {
    mode="install"
    forceManager=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
        "-r" | "--remove") mode="remove" ;;
        "-i" | "--install") mode="install" ;;
        "-y" | "--yay") forceManager="yay" ;;
        "-p" | "--paru") forceManager="paru" ;;
        "-h" | "--help")
            Usage
            exit 0
            ;;
        *)
            echo "Wrong argument '$1'" >&2
            Usage >&2
            exit 1
            ;;
        esac
        shift
    done
}

# Detecting package manager.
DetectPM() {

    #paru support, will select paru if both paru and yay are selected.
    if [[ "$forceManager" == "paru" ]]; then
        if ! command -v paru >/dev/null 2>&1; then
            echo "paru is not installed. Exiting."
            exit 1
        else
            packageManager="paru"
            installCommand=(paru -S)
            removeCommand=(paru -Rns)
            if [[ "$mode" == "remove" ]]; then
                preview="paru -Qi {}"
            else
                preview="paru -Si {}"
            fi
        fi

    #yay support
    elif [[ "$forceManager" == "yay" ]]; then
        if ! command -v yay >/dev/null 2>&1; then
            echo "yay is not installed. Exiting."
            exit 1
        else
            packageManager="yay"
            installCommand=(yay -S)
            removeCommand=(yay -Rns)
            if [[ "$mode" == "remove" ]]; then
                preview="yay -Qi {}"
            else
                preview="yay -Si {}"
            fi
        fi

    #PACMAN support
    elif command -v pacman >/dev/null 2>&1; then
        packageManager="pacman"

        #-Rns removes packages with it's dependencies.
        removeCommand=(sudo pacman -Rns)
        installCommand=(sudo pacman -S)

        if [[ "$mode" == "remove" ]]; then
            ## show preview of installed package
            preview="pacman -Qi {}"
        else
            preview="pacman -Si {}"
        fi

    #APT support
    elif command -v apt >/dev/null 2>&1; then
        packageManager="apt"
        removeCommand=(sudo apt-get remove)
        installCommand=(sudo apt-get install)

        if [[ "$mode" == "remove" ]]; then
            preview="dpkg -s {} 2>/dev/null"
        else
            preview="apt-cache show {}"
        fi

    #Brew suppport
    elif command -v brew >/dev/null 2>&1; then
        packageManager="brew"
        removeCommand=(brew uninstall)
        installCommand=(brew install)
        preview="brew info {}"

    #DNF support
    elif command -v dnf >/dev/null 2>&1; then
        packageManager="dnf"
        removeCommand=(sudo dnf remove)
        installCommand=(sudo dnf install)
        preview="dnf info {}"

    #ZYPPER suppport
    elif command -v zypper >/dev/null 2>&1; then
        packageManager="zypper"
        removeCommand=(sudo zypper remove)
        installCommand=(sudo zypper install)
        preview="zypper info {}"

    #Exit if no package manager found.
    else
        echo "No supported package manager found."
        exit 1
    fi

    if [[ "$mode" == "remove" ]]; then
        operation=("${removeCommand[@]}")
    else
        operation=("${installCommand[@]}")
    fi

}

ListPackages() {
    case "$packageManager:$mode" in
    paru:remove) paru -Qq ;;
    paru:install) paru -Ssq ;;
    yay:remove) yay -Qq ;;
    yay:install) yay -Ssq ;;
    pacman:remove) pacman -Qq ;;
    pacman:install) pacman -Ssq ;;
    apt:remove) dpkg-query -W -f='${Package}\n' ;;
    apt:install) apt-cache pkgnames ;;
    brew:remove) brew list -1 ;;
    brew:install) brew formulae && brew casks ;;
    dnf:remove) dnf -q list installed | tail -n +2 | awk '{print $1}' ;;
    dnf:install) dnf -q list available | tail -n +2 | awk '{print $1}' ;;
    zypper:remove) zypper -q search -i | tail -n +5 | awk -F'|' '{print $2}' | tr -d ' ' ;;
    zypper:install) zypper -q search | tail -n +5 | awk -F'|' '{print $2}' | tr -d ' ' ;;
    *) return 1 ;;
    esac
}

CheckFzf() {
    #Check if fzf is installed.
    if ! command -v fzf >/dev/null 2>&1; then
        echo "fzf is not installed."

        #ask to user if they want to install fzf.
        read -r -p "Do you want to install fzf using $packageManager? (y/N): " fzfAns

        if [[ "$fzfAns" == "y" || "$fzfAns" == "Y" ]]; then
            echo "installing fzf..."
            "${installCommand[@]}" fzf

            #check if fzf installation complete
            if ! command -v fzf >/dev/null 2>&1; then
                echo "fzf installation failed. Please re-run the script or install it manually."
                exit 1
            else
                echo "fzf installation complete."
            fi
        else
            echo "Can not run the script without fzf. Exiting."
            exit 1
        fi
    fi
}

HandleAur() {
    local packageList aurSelected fzfResult package
    local -a packages

    if command -v yay >/dev/null 2>&1; then
        aurHelper="yay"
    elif command -v paru >/dev/null 2>&1; then
        aurHelper="paru"
    else
        echo "No AUR helper found. Exiting."
        exit 0
    fi

    read -r -p "Do you wish to search  using $aurHelper? (y/N): " aurAns
    if [[ "$aurAns" == "y" || "$aurAns" == "Y" ]]; then
        echo "Listing AUR packages."
        packageList=$(mktemp "${TMPDIR:-/tmp}/fuzin.XXXXXX") || return 1

        if ! "$aurHelper" -Slq >"$packageList"; then
            rm -f "$packageList"
            echo "Could not list AUR packages." >&2
            return 1
        fi

        aurSelected=$(fzf -m --prompt="AUR> " <"$packageList")
        fzfResult=$?
        rm -f "$packageList"

        if [[ $fzfResult -eq 130 ]]; then
            echo "Cancelled."
            return 130
        elif [[ $fzfResult -ne 0 && $fzfResult -ne 1 ]]; then
            echo "fzf failed." >&2
            return "$fzfResult"
        fi

        if [[ -n "$aurSelected" ]]; then
            while IFS= read -r package; do
                [[ -n "$package" ]] && packages+=("$package")
            done <<<"$aurSelected"
            echo "${packages[*]} will be installed using $aurHelper."
            "$aurHelper" -S "${packages[@]}"
        else
            echo "No package selected. Exiting."
        fi
    else
        echo "No package selected. Exiting."
    fi
}

Run() {
    local prompt selectedPackages packageList fzfResult package
    local -a packages

    prompt=$(tr '[:lower:]' '[:upper:]' <<<"${mode:0:1}")${mode:1}
    packageList=$(mktemp "${TMPDIR:-/tmp}/fuzin.XXXXXX") || return 1

    if ! ListPackages >"$packageList"; then
        rm -f "$packageList"
        echo "Could not list packages using $packageManager." >&2
        return 1
    fi

    selectedPackages=$(fzf -m --preview="$preview" --preview-window=top:50%:wrap --prompt="$prompt ($packageManager)> " <"$packageList")
    fzfResult=$?
    rm -f "$packageList"

    if [[ $fzfResult -eq 130 ]]; then
        echo "Cancelled."
        return 130
    elif [[ $fzfResult -ne 0 && $fzfResult -ne 1 ]]; then
        echo "fzf failed." >&2
        return "$fzfResult"
    fi

    if [[ -n "$selectedPackages" ]]; then
        while IFS= read -r package; do
            [[ -n "$package" ]] && packages+=("$package")
        done <<<"$selectedPackages"
        echo "$prompt ${packages[*]}"
        "${operation[@]}" "${packages[@]}"
    else
        if [[ $packageManager == "pacman" && $mode == "install" ]]; then
            HandleAur
        else
            echo "No package selected, Exiting."
        fi
    fi
}

main() {
    ParseArguments "$@"
    DetectPM
    CheckFzf
    Run
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
